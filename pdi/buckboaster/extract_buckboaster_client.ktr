    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>build_iso_birthdate</jsScript_name>
        <jsScript_script>// The source stores years on two digits (36..94).
// We rebuild an explicit ISO date in the 1900s to avoid 00xx/20xx drift.
var date_naissance_iso = null;
var dob_raw = dob == null ? null : "" + dob;
if (dob_raw != null &amp;&amp; dob_raw.length >= 8) {
  var date_part = dob_raw.split(" ")[0];
  var dob_parts = date_part.split("/");
  if (dob_parts.length == 3) {
    date_naissance_iso = "19" + dob_parts[2] + "-" + dob_parts[0] + "-" + dob_parts[1];
  }
}</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>date_naissance_iso</name>
        <rename>date_naissance_iso</rename>
        <type>String</type>
        <length>10</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
