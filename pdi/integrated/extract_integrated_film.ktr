  <step>
    <name>input_buckboaster_film_integrated</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>mysql_mm_integrated_pdi</connection>
    <sql>SELECT
  p_int.produit_id,
  src.annee_production,
  src.scenariste,
  src.realisateur,
  src.date_sortie
FROM mm_integrated.PRODUIT p_int
JOIN (
  SELECT
    CASE
      WHEN p.film_id_source IS NOT NULL AND f.titre IS NOT NULL
        THEN CONCAT('BB_FILM_REF_', p.film_id_source, ' :: ', f.titre)
      WHEN p.film_id_source IS NOT NULL
        THEN CONCAT('BB_FILM_REF_', p.film_id_source)
      ELSE CONCAT('BB_FILM_PRODUCT_', p.produit_id)
    END AS titre,
    p.prix_catalogue,
    f.annee AS annee_production,
    NULL AS scenariste,
    NULL AS realisateur,
    CAST(NULL AS DATETIME) AS date_sortie
  FROM mm_src_buckboaster.PRODUIT p
  LEFT JOIN mm_src_buckboaster.FILM f
    ON p.film_id_source = f.film_id
  WHERE p.type_produit = 'film'
) src
  ON p_int.type_produit = 'film'
 AND p_int.titre = src.titre
 AND (
      (p_int.prix_catalogue = src.prix_catalogue)
      OR (p_int.prix_catalogue IS NULL AND src.prix_catalogue IS NULL)
 )</sql>
