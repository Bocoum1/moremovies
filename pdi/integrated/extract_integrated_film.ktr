    <sql>SELECT
  p_int.produit_id,
  src.annee_production,
  src.scenariste,
  src.realisateur,
  src.date_sortie
FROM mm_integrated.PRODUIT p_int
JOIN (
  SELECT
    CASE
      WHEN titre IS NOT NULL THEN CONCAT('MS_FILM_REF_', film_id, ' :: ', titre)
      ELSE CONCAT('MS_FILM_REF_', film_id)
    END AS titre,
    prix_sortie AS prix_catalogue,
    annee_production,
    scenariste,
    realisateur,
    date_sortie
  FROM mm_src_metrostarlet.FILM
) src
  ON p_int.type_produit = 'film'
 AND p_int.titre = src.titre
 AND (
      (p_int.prix_catalogue = src.prix_catalogue)
      OR (p_int.prix_catalogue IS NULL AND src.prix_catalogue IS NULL)
 )</sql>
