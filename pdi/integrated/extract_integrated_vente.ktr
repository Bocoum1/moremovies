  <step>
    <name>input_buckboaster_vente_integrated</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>mysql_mm_src_buckboaster_pdi</connection>
    <sql>SELECT
  1 AS magasin_id,
  c_int.client_id,
  p_int.produit_id,
  v.date_vente,
  v.prix_vente
FROM mm_src_buckboaster.VENTE v
JOIN mm_src_buckboaster.CLIENT c_src
  ON v.client_id = c_src.client_id
JOIN mm_src_buckboaster.PRODUIT p_src
  ON v.produit_id = p_src.produit_id
LEFT JOIN mm_src_buckboaster.FILM f_src
  ON p_src.film_id_source = f_src.film_id
JOIN mm_integrated.CLIENT c_int
  ON BINARY c_int.nom = BINARY c_src.nom
 AND BINARY c_int.prenom = BINARY c_src.prenom
 AND c_int.prenom_milieu IS NULL
 AND BINARY c_int.genre = BINARY c_src.sexe
 AND c_int.date_naissance = c_src.date_naissance
 AND c_int.adresse IS NULL
JOIN mm_integrated.PRODUIT p_int
  ON p_int.type_produit = p_src.type_produit
 AND BINARY p_int.titre = BINARY (
      CASE
        WHEN p_src.type_produit = 'gadget' THEN p_src.titre
        WHEN p_src.film_id_source IS NOT NULL AND f_src.titre IS NOT NULL
          THEN CONCAT('BB_FILM_REF_', p_src.film_id_source, ' :: ', f_src.titre)
        WHEN p_src.film_id_source IS NOT NULL
          THEN CONCAT('BB_FILM_REF_', p_src.film_id_source)
        ELSE CONCAT('BB_FILM_PRODUCT_', p_src.produit_id)
      END
 )
 AND (
      (p_int.prix_catalogue = p_src.prix_catalogue)
      OR (p_int.prix_catalogue IS NULL AND p_src.prix_catalogue IS NULL)
 )</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>160</xloc><yloc>32</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>input_metrostarlet_vente_integrated</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>mysql_mm_src_metrostarlet_pdi</connection>
    <sql>SELECT
  2 AS magasin_id,
  c_int.client_id,
  p_int.produit_id,
  v.date_vente,
  v.prix_vente
FROM mm_src_metrostarlet.VENTE v
JOIN mm_src_metrostarlet.CLIENT c_src
  ON v.client_id = c_src.client_id
JOIN mm_src_metrostarlet.EXEMPLAIRE_VENTE ev
  ON v.exemplaire_vente_id = ev.exemplaire_vente_id
JOIN mm_src_metrostarlet.FILM f_src
  ON ev.film_id = f_src.film_id
JOIN mm_integrated.CLIENT c_int
  ON BINARY c_int.nom = BINARY c_src.nom
 AND BINARY c_int.prenom = BINARY c_src.prenom_usage
 AND (
      (BINARY c_int.prenom_milieu = BINARY c_src.prenom_milieu)
      OR (c_int.prenom_milieu IS NULL AND c_src.prenom_milieu IS NULL)
 )
 AND BINARY c_int.genre = BINARY c_src.genre
 AND c_int.date_naissance = c_src.date_naissance
 AND BINARY c_int.adresse = BINARY c_src.adresse
JOIN mm_integrated.PRODUIT p_int
  ON p_int.type_produit = 'film'
 AND BINARY p_int.titre = BINARY (
      CASE
        WHEN f_src.titre IS NOT NULL THEN CONCAT('MS_FILM_REF_', f_src.film_id, ' :: ', f_src.titre)
        ELSE CONCAT('MS_FILM_REF_', f_src.film_id)
      END
 )
 AND (
      (p_int.prix_catalogue = f_src.prix_sortie)
      OR (p_int.prix_catalogue IS NULL AND f_src.prix_sortie IS NULL)
 )</sql>
    <limit>0</limit>
