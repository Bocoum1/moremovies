  <step>
    <name>input_moviemegamart_vente_gadget_integrated</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>mysql_mm_src_moviemegamart_pdi</connection>
    <sql>SELECT
  3 AS magasin_id,
  c_int.client_id,
  p_int.produit_id,
  v.date_vente,
  v.prix_vente
FROM mm_src_moviemegamart.VENTE_GADGET v
JOIN mm_src_moviemegamart.CLIENT c_src
  ON v.client_id = c_src.client_id
JOIN mm_src_moviemegamart.MODELE_GADGET g_src
  ON v.gadget_id = g_src.gadget_id
JOIN mm_integrated.CLIENT c_int
  ON BINARY c_int.nom = BINARY c_src.nom_client
 AND c_int.prenom IS NULL
 AND c_int.prenom_milieu IS NULL
 AND BINARY c_int.genre = BINARY (CASE WHEN c_src.sexe_masculin = 1 THEN 'M' ELSE 'F' END)
 AND c_int.date_naissance = c_src.date_naissance
 AND BINARY c_int.adresse = BINARY c_src.adresse
JOIN mm_integrated.PRODUIT p_int
  ON p_int.type_produit = 'gadget'
 AND BINARY p_int.titre = BINARY g_src.titre_gadget
 AND p_int.prix_catalogue IS NULL</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
