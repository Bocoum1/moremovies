    <compare>
      <condition>
        <negated>N</negated>
        <operator>AND</operator>
        <leftvalue>acteur_id</leftvalue>
        <function>IS NOT NULL</function>
        <rightvalue/>
      </condition>
      <condition>
        <negated>N</negated>
        <operator>AND</operator>
        <leftvalue>produit_id</leftvalue>
        <function>IS NOT NULL</function>
        <rightvalue/>
      </condition>
    </compare>
    <attributes/>
