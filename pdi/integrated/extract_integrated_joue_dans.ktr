  <step>
    <name>input_buckboaster_joue_dans_integrated</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>mysql_mm_src_buckboaster_pdi</connection>
    <sql>SELECT
  a_int.acteur_id,
  p_int.produit_id
FROM mm_src_buckboaster.JOUE_DANS jd
JOIN mm_src_buckboaster.ACTEUR a
  ON jd.acteur_id = a.acteur_id
JOIN (
  SELECT
    p.film_id_source,
    CASE
      WHEN p.film_id_source IS NOT NULL AND f.titre IS NOT NULL
        THEN CONCAT('BB_FILM_REF_', p.film_id_source, ' :: ', f.titre)
      WHEN p.film_id_source IS NOT NULL
        THEN CONCAT('BB_FILM_REF_', p.film_id_source)
      ELSE CONCAT('BB_FILM_PRODUCT_', p.produit_id)
    END AS titre,
    p.prix_catalogue
  FROM mm_src_buckboaster.PRODUIT p
  LEFT JOIN mm_src_buckboaster.FILM f
    ON p.film_id_source = f.film_id
  WHERE p.type_produit = 'film'
) src_f
  ON jd.film_id = src_f.film_id_source
JOIN mm_integrated.ACTEUR a_int
  ON BINARY a_int.nom_acteur = BINARY a.nom
JOIN mm_integrated.PRODUIT p_int
  ON p_int.type_produit = 'film'
 AND BINARY p_int.titre = BINARY src_f.titre
 AND (
      (p_int.prix_catalogue = src_f.prix_catalogue)
      OR (p_int.prix_catalogue IS NULL AND src_f.prix_catalogue IS NULL)
 )</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>160</xloc><yloc>80</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>input_metrostarlet_joue_dans_integrated</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>mysql_mm_src_metrostarlet_pdi</connection>
    <sql>SELECT
  a_int.acteur_id,
  p_int.produit_id
FROM mm_src_metrostarlet.JOUE_DANS jd
JOIN mm_src_metrostarlet.ACTEUR a
  ON jd.acteur_id = a.acteur_id
JOIN (
  SELECT
    film_id,
    CASE
      WHEN titre IS NOT NULL THEN CONCAT('MS_FILM_REF_', film_id, ' :: ', titre)
      ELSE CONCAT('MS_FILM_REF_', film_id)
    END AS titre,
    prix_sortie AS prix_catalogue
  FROM mm_src_metrostarlet.FILM
) src_f
  ON jd.film_id = src_f.film_id
JOIN mm_integrated.ACTEUR a_int
  ON BINARY a_int.nom_acteur = BINARY a.nom_acteur
JOIN mm_integrated.PRODUIT p_int
  ON p_int.type_produit = 'film'
 AND BINARY p_int.titre = BINARY src_f.titre
 AND (
      (p_int.prix_catalogue = src_f.prix_catalogue)
      OR (p_int.prix_catalogue IS NULL AND src_f.prix_catalogue IS NULL)
 )</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>160</xloc><yloc>272</yloc><draw>Y</draw></GUI>
  </step>
