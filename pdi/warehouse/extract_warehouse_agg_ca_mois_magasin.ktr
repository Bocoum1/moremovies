    <tablename_in_table>N</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field><column_name>annee</column_name><stream_name>annee</stream_name></field>
      <field><column_name>mois</column_name><stream_name>mois</stream_name></field>
      <field><column_name>magasin_key</column_name><stream_name>magasin_key</stream_name></field>
      <field><column_name>ca_vente</column_name><stream_name>ca_vente</stream_name></field>
      <field><column_name>ca_location</column_name><stream_name>ca_location</stream_name></field>
      <field><column_name>ca_total</column_name><stream_name>ca_total</stream_name></field>
    </fields>
    <GUI><xloc>544</xloc><yloc>144</yloc><draw>Y</draw></GUI>
  </step>
