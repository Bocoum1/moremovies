  <order>
    <hop>
      <from>input_ca_mois_magasin_for_agg</from>
      <to>load_agg_ca_mois_magasin</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>input_ca_mois_magasin_for_agg</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>mysql_mm_warehouse_pdi</connection>
    <sql>SELECT
  base.annee,
  base.mois,
  base.magasin_key,
  COALESCE(v.ca_vente, 0) AS ca_vente,
  COALESCE(l.ca_location, 0) AS ca_location,
  COALESCE(v.ca_vente, 0) + COALESCE(l.ca_location, 0) AS ca_total
FROM (
  SELECT DISTINCT annee, mois, magasin_key
  FROM AGG_VENTE_MOIS_MAGASIN_PRODUIT
  UNION
  SELECT DISTINCT annee, mois, magasin_key
  FROM AGG_LOCATION_MOIS_MAGASIN_PRODUIT
) base
LEFT JOIN (
  SELECT annee, mois, magasin_key, SUM(ca_vente) AS ca_vente
  FROM AGG_VENTE_MOIS_MAGASIN_PRODUIT
  GROUP BY annee, mois, magasin_key
) v
  ON base.annee = v.annee
 AND base.mois = v.mois
 AND base.magasin_key = v.magasin_key
LEFT JOIN (
  SELECT annee, mois, magasin_key, SUM(ca_location) AS ca_location
  FROM AGG_LOCATION_MOIS_MAGASIN_PRODUIT
  GROUP BY annee, mois, magasin_key
) l
  ON base.annee = l.annee
 AND base.mois = l.mois
 AND base.magasin_key = l.magasin_key
ORDER BY base.annee, base.mois, base.magasin_key</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cluster_schema/>
    <remotesteps><input/></remotesteps>
    <GUI><xloc>208</xloc><yloc>144</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>load_agg_ca_mois_magasin</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>mysql_mm_warehouse_pdi</connection>
    <schema/>
    <table>AGG_CA_MOIS_MAGASIN</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
