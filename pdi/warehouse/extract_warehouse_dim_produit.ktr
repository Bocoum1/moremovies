    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>mysql_mm_integrated_pdi</connection>
    <sql>SELECT
  p.produit_id AS produit_key,
  p.produit_id AS produit_id_source,
  p.titre,
  p.type_produit,
  g.categorie_gadget AS categorie_produit,
  f.annee_production,
  f.scenariste,
  f.realisateur
FROM PRODUIT p
LEFT JOIN FILM f
  ON p.produit_id = f.produit_id
LEFT JOIN GADGET g
  ON p.produit_id = g.produit_id
ORDER BY p.produit_id</sql>
    <limit>0</limit>
    <lookup/>
