export MONDRIAN_SCHEMA_PATH="/path/to/moremovies_public/mondrian/moremovies_schema.xml"

export MONDRIAN_DB_HOST="localhost"
export MONDRIAN_DB_PORT="3306"
export MONDRIAN_DB_NAME="mm_warehouse"

# Prefer a dedicated MySQL user instead of sudo/socket auth.
export MONDRIAN_DB_USER="mondrian_user"
export MONDRIAN_DB_PASSWORD="change_me"

export MONDRIAN_DB_PARAMS="useUnicode=true&characterEncoding=UTF-8&serverTimezone=Europe/Paris"
export MONDRIAN_XMLA_PORT="8888"
export MONDRIAN_XMLA_PATH="/xmla"
